# ralph.config — multi-repo runtime config for the ralph loop (pitchIN workspace).
# Shell-sourced KEY=value file, read by ralph/loop-parallel.sh from the ai/ root.
#
# TWO CONFIG SOURCES — this file only holds OVERRIDES:
#   - ai/.claude/skill-config.json is the canonical source of project facts:
#       per-repo .path / .default_branch / .code_gate, and .tracker.repo (hub slug).
#       The coordinator reads it via jq.
#   - THIS file (ralph.config) only carries what differs from skill-config for a
#       given loop run, and takes precedence over it. Leave a key unset to fall
#       back to skill-config.json. Do NOT duplicate paths or default gates here.

# Issue hub — a SEPARATE repo from the code repos. All `gh issue` calls use -R <hub>.
# Falls back to skill-config .tracker.repo when unset.
RALPH_HUB_REPO=pitchplatforms/pitchin-issues

# GitHub label marking hub issues ready for an agent to pick up.
RALPH_READY_LABEL=ready-for-agent

# Repo keys the loop can work. Each key `k` maps to:
#   - skill-config .repos.<k> (path / default_branch / code_gate), and
#   - a GitHub `repo:<k>` label on hub issues that selects it into a slice.
RALPH_REPOS="api admin customer"

# ── Per-repo overrides (only where they differ from skill-config.json) ────────
# For repo key k, the coordinator reads RALPH_REPO_<k>_BASE / RALPH_REPO_<k>_GATE
# via bash indirect expansion, falling back to skill-config default_branch / code_gate.
#
# API interim override: base = `anthony`, because the full Api.Test suite is green
# there (1196/1196) while staging_v8 is still red. The gate runs only that suite.
# Once anthony -> staging_v8 is merged, DELETE the next two lines to fall back to
# skill-config (staging_v8 + the bare `dotnet test` gate).
RALPH_REPO_api_BASE=anthony
RALPH_REPO_api_GATE="dotnet test Tests/PitchIn.DigitalRegistry.Api.Test --nologo"

# Subagent names the orchestrator/worker delegate to (must exist in .claude/agents/).
RALPH_PLANNER=planner
RALPH_IMPLEMENTER=implementer
